# Tests that create/delete remote fixtures must also set TEST_ENVIRONMENT=true.
TEST_ENVIRONMENT=false
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_KEY=

# --- Spend ceiling -------------------------------------------------------------------------
# Rates are configuration, not facts: vendor pricing changes and is often quoted in credits.
# Both are integers in micros (1 USD = 1_000_000 micros). Unset means the conservative default,
# which deliberately overestimates: refusing a call that would have fitted is an annoyance,
# authorising one that breaks the ceiling is a bill.
SPECTRO_TTS_MICROS_PER_CHARACTER=
SPECTRO_MINIMUM_CHARGE_MICROS=

# Server-only. Never prefix with NEXT_PUBLIC_, never commit, never paste into a chat.
ELEVENLABS_API_KEY=
