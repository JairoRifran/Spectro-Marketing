NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
AUTOMATION_ENABLED=false
DEPLOYMENT_ENVIRONMENT=development
# mock | anthropic | ollama | hybrid. Sin valor, o con uno desconocido, se usa mock: el contenido
# lo escribe el generador deterministico y nunca se paga una llamada que nadie pidio.
#
#   mock      Deterministico. No llama a ningun modelo.
#   anthropic Todo con el modelo pago.
#   ollama    Todo con un modelo local. Ver el aviso de hardware mas abajo.
#   hybrid    Local lo mecanico, pago el posicionamiento, la investigacion y el copy.
AI_PROVIDER=mock
# Server-only. Con AI_PROVIDER=anthropic (o hybrid) es obligatoria; sin ella la tarea falla
# diciendo que falta.
ANTHROPIC_API_KEY=

# Que etapas usan el modelo caro (Opus 5) en vez del estandar (Sonnet 5). Si no se define, se usa
# la lista del codigo: el borrador de estrategia y el copy. Vacio significa que todo va al
# estandar. No confundir con AI_JUDGEMENT_TASKS: esto elige entre dos Claude, aquello elige entre
# Claude y el modelo local.
AI_PREMIUM_TASKS=

# Que etapas van al modelo pago cuando AI_PROVIDER=hybrid. Si no se define, se usa la lista del
# codigo: borrador de estrategia, investigacion y copy. Vacio significa que no se escala nada.
AI_JUDGEMENT_TASKS=

# --- Modelo local (Ollama) ---
# ATENCION: solo alcanzable desde la maquina donde corre Ollama. Una funcion en Vercel no puede
# llegar a un modelo que corre en tu notebook, y el sintoma es una conexion rechazada.
#
# Medido en una notebook sin GPU dedicada (Iris Xe, 16 GB): generacion libre ~11-13 tokens/s, y
# una etapa real de investigacion con su esquema completo no termino en diez minutos. Sirve para
# desarrollo y pruebas de punta a punta; no sirve para que una persona espere una campana.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Ollama no avisa cuando el prompt no entra: descarta el principio en silencio. Un contexto de
# campana que pierde la marca devuelve algo bien formado y sin valor.
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_MS=600000
OPENAI_API_KEY=
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
APP_URL=http://localhost:3000
DISPATCH_BATCH_SIZE=5
TASK_LEASE_SECONDS=120

# Tests that create/delete remote fixtures must also set TEST_ENVIRONMENT=true.
TEST_ENVIRONMENT=false
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_KEY=

# --- Spend ceiling -------------------------------------------------------------------------
# Rates are configuration, not facts: vendor pricing changes and is often quoted in credits.
# Both are integers in micros (1 USD = 1_000_000 micros). Unset means the conservative default,
# which deliberately overestimates: refusing a call that would have fitted is an annoyance,
# authorising one that breaks the ceiling is a bill.
# Speech bills by the characters sent; sound and music bill by the seconds produced. Pricing
# them in one unit would misprice two of the three.
SPECTRO_TTS_MICROS_PER_CHARACTER=
SPECTRO_SFX_MICROS_PER_SECOND=
SPECTRO_MUSIC_MICROS_PER_SECOND=
SPECTRO_MINIMUM_CHARGE_MICROS=

# Server-only. Never prefix with NEXT_PUBLIC_, never commit, never paste into a chat.
# Both are required for the real provider; with either missing, the mock is used instead and
# returns a tone that is obviously not speech. The voice has no default on purpose: a vendor's
# default voice is a choice nobody made, and it would be the voice of the brand.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional. A free account lifts the image rate limit and removes the watermark.
POLLINATIONS_TOKEN=

# Social integrations. Server-only: these never reach the browser and never belong in the repo.
# The redirect URI registered in each portal must match exactly what the Integración screen shows.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Signs the OAuth state so a callback cannot be forged. Falls back to the service role key.
INTEGRATION_STATE_SECRET=
# Encrypts persisted client secrets and social tokens with AES-256-GCM. Generate exactly 32 bytes:
# openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# Optional comma-separated old keys. Keep them only during rotation; reads rewrite with the active key.
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=
